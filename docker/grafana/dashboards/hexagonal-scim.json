          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-hexagonal-scim"
          },
          "expr": "sum(rate(account_operations_total{application=\"hexagonal-scim\"}[2m])) by (operation)",
          "legendFormat": "{{operation}}",
          "refId": "A"
