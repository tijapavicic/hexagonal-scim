@startuml
title Hexagonal SCIM - Component Diagram (Architecture Split)

skinparam backgroundColor #0D1117
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontName Arial
skinparam defaultFontColor #E6EDF3
skinparam ArrowColor #58A6FF
skinparam ArrowThickness 1.3
skinparam packageStyle rectangle
skinparam linetype ortho

left to right direction

actor "API Client" as Client
database "PostgreSQL / H2" as Db

package "hex-inbound-adapter-web" as user_in {
  component "UserControllerAdapter" as UserController
  component "ApiExceptionHandlerAdapter" as UserExHandler
}

package "hex-core" as user_core {
  component "UserService" as UserService
  component "CreateUserPort / GetUserPort\nGetAllUsersPort / UpdateUserPort\nPatchUserPort / DeleteUserPort" as UserInPorts
  component "UserRepositoryPort" as UserOutPort
}

package "hex-outbound-adapter-db" as user_out {
  component "UserRepositoryAdapter" as UserRepoAdapter
  component "UserJpaRepository" as UserJpa
}

package "hex-inbound-adapter-payment-web" as pay_in {
  component "ProductControllerAdapter" as ProductController
  component "PaymentControllerAdapter" as PaymentController
  component "PaymentApiExceptionHandler" as PaymentExHandler
}

package "hex-payment-core" as pay_core {
  component "ProductService" as ProductService
  component "PaymentService" as PaymentService
  component "Product Ports\nCreate/Get/GetAll/Update/Delete" as ProductInPorts
  component "Payment Ports\nInitiate/Get/GetAll" as PaymentInPorts
  component "ProductRepositoryPort" as ProductOutPort
  component "PaymentRepositoryPort" as PaymentOutPort
  component "PaymentStrategyPort" as PaymentStrategyPort
}

package "hex-outbound-adapter-payment-db" as pay_out {
  component "ProductRepositoryAdapter" as ProductRepoAdapter
  component "PaymentRepositoryAdapter" as PaymentRepoAdapter
  component "ProductJpaRepository" as ProductJpa
  component "PaymentJpaRepository" as PaymentJpa
  component "PaymentStrategyRegistry" as StrategyRegistry
  component "BankTransferGatewayAdapter" as BankGateway
  component "PayPalGatewayAdapter" as PaypalGateway
  component "IdealGatewayAdapter" as IdealGateway
}

package "hex-application (composition root)" as app {
  component "HexagonalScimApplication" as BootApp
  component "UserConfig" as UserConfig
  component "ProductConfig" as ProductConfig
  component "PaymentConfig" as PaymentConfig
  component "PaymentDbAdapterConfig" as PaymentDbConfig
  component "PaymentStrategyConfig" as PaymentStrategyConfig
}

Client --> UserController : /api/v1/users, /api/users
Client --> ProductController : /api/v1/products
Client --> PaymentController : /api/v1/payments

UserController --> UserInPorts
UserInPorts --> UserService
UserService --> UserOutPort
UserOutPort --> UserRepoAdapter
UserRepoAdapter --> UserJpa
UserJpa --> Db
UserController ..> UserExHandler

ProductController --> ProductInPorts
ProductInPorts --> ProductService
ProductService --> ProductOutPort
ProductOutPort --> ProductRepoAdapter
ProductRepoAdapter --> ProductJpa
ProductJpa --> Db
ProductController ..> PaymentExHandler

PaymentController --> PaymentInPorts
PaymentInPorts --> PaymentService
PaymentService --> ProductOutPort : read/update stock
PaymentService --> PaymentOutPort : persist payment
PaymentService --> PaymentStrategyPort : resolve method
PaymentOutPort --> PaymentRepoAdapter
PaymentRepoAdapter --> PaymentJpa
PaymentJpa --> Db
PaymentStrategyPort --> StrategyRegistry
StrategyRegistry --> BankGateway
StrategyRegistry --> PaypalGateway
StrategyRegistry --> IdealGateway
PaymentController ..> PaymentExHandler

BootApp --> UserConfig
BootApp --> ProductConfig
BootApp --> PaymentConfig
BootApp --> PaymentDbConfig
BootApp --> PaymentStrategyConfig

UserConfig ..> UserInPorts
UserConfig ..> UserOutPort
ProductConfig ..> ProductInPorts
PaymentConfig ..> PaymentInPorts
PaymentConfig ..> ProductOutPort
PaymentConfig ..> PaymentOutPort
PaymentConfig ..> PaymentStrategyPort
PaymentDbConfig ..> ProductOutPort
PaymentDbConfig ..> PaymentOutPort
PaymentStrategyConfig ..> PaymentStrategyPort

note bottom
Module dependency direction:
- hex-inbound-adapter-web -> hex-core
- hex-outbound-adapter-db -> hex-core
- hex-inbound-adapter-payment-web -> hex-payment-core
- hex-outbound-adapter-payment-db -> hex-payment-core
- hex-application -> all modules (composition root)
- hex-core and hex-payment-core are independent domain cores
end note


@enduml