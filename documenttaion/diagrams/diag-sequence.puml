@startuml
title Hexagonal SCIM - Sequence Diagram (User + Payment/Product Split)

skinparam backgroundColor #0D1117
skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontName Arial
skinparam defaultFontColor #E6EDF3
skinparam defaultFontSize 12
skinparam ArrowColor #58A6FF
skinparam ArrowThickness 1.3
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantBorderColor #30363D
skinparam ParticipantBackgroundColor #161B22
skinparam LifelineBorderColor #4B5563
skinparam LifelineBackgroundColor #0F172A
skinparam NoteBackgroundColor #1F2937
skinparam NoteBorderColor #374151
skinparam NoteFontColor #D1D5DB

actor "API Client" as Client
participant "HexagonalScimApplication\n(hex-application)" as App
participant "UserConfig / ProductConfig\nPaymentConfig" as AppConfig

participant "UserControllerAdapter\n(hex-inbound-adapter-web)" as UserController
participant "UserService\n(hex-core)" as UserService
participant "UserRepositoryAdapter\n(hex-outbound-adapter-db)" as UserRepo

participant "ProductControllerAdapter\n(hex-inbound-adapter-payment-web)" as ProductController
participant "PaymentControllerAdapter\n(hex-inbound-adapter-payment-web)" as PaymentController
participant "ProductService\n(hex-payment-core)" as ProductService
participant "PaymentService\n(hex-payment-core)" as PaymentService
participant "ProductRepositoryAdapter\n(hex-outbound-adapter-payment-db)" as ProductRepo
participant "PaymentRepositoryAdapter\n(hex-outbound-adapter-payment-db)" as PaymentRepo
participant "PaymentStrategyRegistry\n(hex-outbound-adapter-payment-db)" as StrategyRegistry
participant "PayPal/BankTransfer/Ideal\nGatewayAdapters" as Gateway

database "PostgreSQL / H2" as Db

== Composition Root Bootstrap ==
App -> AppConfig: create beans + wire ports/adapters
AppConfig --> UserService: UserService bean
AppConfig --> ProductService: ProductService bean
AppConfig --> PaymentService: PaymentService bean
AppConfig --> UserRepo: UserRepositoryPort impl
AppConfig --> ProductRepo: ProductRepositoryPort impl
AppConfig --> PaymentRepo: PaymentRepositoryPort impl
AppConfig --> StrategyRegistry: PaymentStrategyPort impl

== Flow 1: User Create ==
Client -> UserController: POST /api/v1/users
activate UserController
UserController -> UserService: create(email, displayName)
activate UserService
UserService -> UserRepo: existsByEmail(email)
activate UserRepo
UserRepo -> Db: SELECT users by email
Db --> UserRepo: false
UserRepo --> UserService: false
UserService -> UserRepo: save(User)
UserRepo -> Db: INSERT users
Db --> UserRepo: persisted row
UserRepo --> UserService: User(id,...)
UserService --> UserController: User(id,...)
UserController --> Client: 201 Created
deactivate UserRepo
deactivate UserService
deactivate UserController

== Flow 2: Product Create ==
Client -> ProductController: POST /api/v1/products
activate ProductController
ProductController -> ProductService: create(name, price, stock...)
activate ProductService
ProductService -> ProductRepo: existsByName(name)
activate ProductRepo
ProductRepo -> Db: SELECT products by name
Db --> ProductRepo: false
ProductRepo --> ProductService: false
ProductService -> ProductRepo: save(Product)
ProductRepo -> Db: INSERT products
Db --> ProductRepo: persisted row
ProductRepo --> ProductService: Product(id,...)
ProductService --> ProductController: Product(id,...)
ProductController --> Client: 201 Created
deactivate ProductRepo
deactivate ProductService
deactivate ProductController

== Flow 3: Payment Initiation ==
Client -> PaymentController: POST /api/v1/payments
activate PaymentController
PaymentController -> PaymentService: initiate(productId, qty, method)
activate PaymentService
PaymentService -> ProductRepo: findById(productId)
activate ProductRepo
ProductRepo -> Db: SELECT product
Db --> ProductRepo: Product(stock, price)
ProductRepo --> PaymentService: Product(...)
deactivate ProductRepo

PaymentService -> PaymentRepo: save(PENDING)
activate PaymentRepo
PaymentRepo -> Db: INSERT payment(PENDING)
Db --> PaymentRepo: payment row
PaymentRepo --> PaymentService: Payment(id,PENDING)
deactivate PaymentRepo

PaymentService -> StrategyRegistry: resolve(paymentMethod)
activate StrategyRegistry
StrategyRegistry --> PaymentService: PaymentGatewayPort
PaymentService -> Gateway: process(payment)
Gateway --> PaymentService: COMPLETED
deactivate StrategyRegistry

PaymentService -> PaymentRepo: save(COMPLETED)
activate PaymentRepo
PaymentRepo -> Db: UPDATE payment(COMPLETED)
Db --> PaymentRepo: updated row
PaymentRepo --> PaymentService: Payment(id,COMPLETED)
deactivate PaymentRepo

PaymentService -> ProductRepo: update(stock - qty)
activate ProductRepo
ProductRepo -> Db: UPDATE product stock
Db --> ProductRepo: updated
ProductRepo --> PaymentService: Product(...)
deactivate ProductRepo

PaymentService --> PaymentController: PaymentResponse
PaymentController --> Client: 201 Created
deactivate PaymentService
deactivate PaymentController

legend right
|= Module |= Responsibility |
| hex-application | composition root / bean wiring |
| hex-inbound-adapter-web | user API entrypoints |
| hex-core | user domain + ports |
| hex-outbound-adapter-db | user persistence adapter |
| hex-inbound-adapter-payment-web | product/payment API entrypoints |
| hex-payment-core | product/payment domain + ports |
| hex-outbound-adapter-payment-db | payment/product persistence + gateways |
endlegend

@enduml