{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "hexagonal-scim",
    "description": "Full CRUD API + Keycloak authentication for the hexagonal-scim service.\n\n**Quick start (Docker Compose mode)**\n1. Disable SSL verification in Postman: Settings → General → SSL certificate verification → OFF (needed for self-signed cert).\n2. Run **Keycloak / Get Token — testuser** — the JWT is stored automatically in {{accessToken}}.\n3. All API requests inherit the Bearer token from the collection.\n\n**Local dev mode (no Keycloak)**\nNo token required. The API is open when started with `mvn spring-boot:run` (H2, no Keycloak).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Keycloak",
      "description": "Token requests against Keycloak (https://localhost:8443). Run one of these first.\n\n⚠️ Disable SSL verification in Postman settings (self-signed cert).",
      "item": [
        {
          "name": "Get Token — testuser (password grant)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('access_token present', () => pm.expect(json).to.have.property('access_token'));",
            "pm.collectionVariables.set('accessToken', json.access_token);",
            "pm.test('Token stored', () => pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password", "type": "text" },
              { "key": "client_id",  "value": "{{keycloakPublicClientId}}", "type": "text" },
              { "key": "username",   "value": "testuser", "type": "text" },
              { "key": "password",   "value": "password", "type": "text" }
            ]},
            "url": { "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token", "host": ["{{keycloakUrl}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        },
        {
          "name": "Get Token — adminuser (password grant)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.collectionVariables.set('accessToken', json.access_token);",
            "pm.test('Token stored', () => pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password", "type": "text" },
              { "key": "client_id",  "value": "{{keycloakPublicClientId}}", "type": "text" },
              { "key": "username",   "value": "adminuser", "type": "text" },
              { "key": "password",   "value": "password", "type": "text" }
            ]},
            "url": { "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token", "host": ["{{keycloakUrl}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        },
        {
          "name": "Get Token — M2M (client credentials)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.collectionVariables.set('accessToken', json.access_token);",
            "pm.test('Token stored', () => pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type",    "value": "client_credentials", "type": "text" },
              { "key": "client_id",     "value": "{{keycloakConfClientId}}", "type": "text" },
              { "key": "client_secret", "value": "{{keycloakConfClientSecret}}", "type": "text" }
            ]},
            "url": { "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token", "host": ["{{keycloakUrl}}"], "path": ["realms","{{realm}}","protocol","openid-connect","token"] }
          }
        },
        {
          "name": "Decode Token (userinfo)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('preferred_username present', () => pm.expect(pm.response.json()).to.have.property('preferred_username'));"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/userinfo", "host": ["{{keycloakUrl}}"], "path": ["realms","{{realm}}","protocol","openid-connect","userinfo"] }
          }
        },
        {
          "name": "OIDC Discovery",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('issuer present', () => pm.expect(pm.response.json()).to.have.property('issuer'));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "{{keycloakUrl}}/realms/{{realm}}/.well-known/openid-configuration", "host": ["{{keycloakUrl}}"], "path": ["realms","{{realm}}",".well-known","openid-configuration"] }
          }
        }
      ]
    },
    {
      "name": "Versioned API — v1",
      "description": "All endpoints inherit Bearer token from {{accessToken}}. Run a Keycloak token request first when using Docker Compose.",
      "item": [
        {
          "name": "Create user",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('uniqueEmail', 'user.' + suffix + '@example.com');"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.test('has id, email, displayName', () => { pm.expect(json).to.have.property('id'); pm.expect(json).to.have.property('email'); pm.expect(json).to.have.property('displayName'); });",
              "pm.test('no deprecation headers', () => { pm.expect(pm.response.headers.get('Deprecation')).to.be.null; pm.expect(pm.response.headers.get('Sunset')).to.be.null; });",
              "pm.collectionVariables.set('userId', String(json.id));"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{uniqueEmail}}\",\n  \"displayName\": \"Alice\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api","v1","users"] }
          }
        },
        {
          "name": "Get all users (paginated)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('has pagination fields', () => { pm.expect(json).to.have.property('content'); pm.expect(json).to.have.property('pageNumber'); pm.expect(json).to.have.property('pageSize'); pm.expect(json).to.have.property('totalElements'); pm.expect(json).to.have.property('totalPages'); pm.expect(json).to.have.property('hasNext'); pm.expect(json).to.have.property('hasPrevious'); });",
            "pm.test('content is array', () => pm.expect(json.content).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","users"], "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}] }
          }
        },
        {
          "name": "Get all users (unpaged — all records)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('content length equals totalElements', () => pm.expect(json.content.length).to.equal(json.totalElements));",
            "pm.test('totalPages is 1', () => pm.expect(json.totalPages).to.equal(1));"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users?pageable=false", "host": ["{{baseUrl}}"], "path": ["api","v1","users"], "query": [{"key":"pageable","value":"false"}] }
          }
        },
        {
          "name": "Get user by id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('id matches', () => pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('userId')));",
            "pm.test('has email and displayName', () => { pm.expect(json).to.have.property('email'); pm.expect(json).to.have.property('displayName'); });",
            "pm.test('no deprecation headers', () => { pm.expect(pm.response.headers.get('Deprecation')).to.be.null; pm.expect(pm.response.headers.get('Sunset')).to.be.null; });"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"] }
          }
        },
        {
          "name": "Update user — full (PUT)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('id unchanged', () => pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('userId')));",
            "pm.test('displayName updated', () => pm.expect(json.displayName).to.eql('Alice Updated'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice-updated-{{$timestamp}}@example.com\",\n  \"displayName\": \"Alice Updated\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"] }
          }
        },
        {
          "name": "Update user — partial (PATCH)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('id unchanged', () => pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('userId')));",
            "pm.test('displayName patched', () => pm.expect(json.displayName).to.eql('Alice Patched'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Alice Patched\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"] }
          }
        },
        {
          "name": "Delete user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));",
            "pm.test('body is empty', () => pm.expect(pm.response.text()).to.be.empty);"
          ]}}],
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"] }
          }
        },
        {
          "name": "Get user by id — 404 (after delete)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));",
            "pm.test('error code USER_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('USER_NOT_FOUND'));"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Legacy API",
      "description": "Deprecated endpoints — same functionality as v1 but returns Deprecation + Sunset + Link headers.",
      "item": [
        {
          "name": "Create user (legacy)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('uniqueEmail', 'legacy.' + suffix + '@example.com');"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('userId', String(json.id));",
              "pm.test('deprecation headers present', () => { pm.expect(pm.response.headers.get('Deprecation')).to.exist; pm.expect(pm.response.headers.get('Sunset')).to.exist; pm.expect(pm.response.headers.get('Link')).to.exist; });"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{uniqueEmail}}\",\n  \"displayName\": \"Legacy Alice\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"] }
          }
        },
        {
          "name": "Get user by id (legacy)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('id matches', () => pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('userId')));",
            "pm.test('deprecation headers present', () => { pm.expect(pm.response.headers.get('Deprecation')).to.exist; pm.expect(pm.response.headers.get('Sunset')).to.exist; pm.expect(pm.response.headers.get('Link')).to.exist; });"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","users","{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Health & Docs (no auth)",
      "description": "Public endpoints — no token required in any environment.",
      "item": [
        {
          "name": "Health check",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator","health"] }
          }
        },
        {
          "name": "OpenAPI spec",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('openapi field present', () => pm.expect(pm.response.json()).to.have.property('openapi'));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/api-docs", "host": ["{{baseUrl}}"], "path": ["api-docs"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl",                   "value": "http://localhost:8080",  "description": "Spring Boot API base URL" },
    { "key": "keycloakUrl",              "value": "https://localhost:8443", "description": "Keycloak HTTPS URL (Docker Compose)" },
    { "key": "realm",                    "value": "hexagonal-scim",         "description": "Keycloak realm name" },
    { "key": "keycloakPublicClientId",   "value": "hexagonal-scim-public",  "description": "Public PKCE client" },
    { "key": "keycloakConfClientId",     "value": "hexagonal-scim-app",     "description": "Confidential client (M2M)" },
    { "key": "keycloakConfClientSecret", "value": "hexagonal-scim-secret",  "description": "Secret for confidential client" },
    { "key": "accessToken",              "value": "",                       "description": "Populated automatically by Get Token requests" },
    { "key": "userId",                   "value": "1",                      "description": "Populated automatically by Create user" },
    { "key": "uniqueEmail",              "value": "",                       "description": "Populated automatically by pre-request scripts" }
  ]
}
